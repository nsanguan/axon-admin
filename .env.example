# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is remote — no local container needed
DATABASE_URL="postgresql://axon:axon@202.71.1.13:5435/axon_admin?schema=axon_admin"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"
NODE_ENV="development"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="change_me_generate_with_openssl_rand_base64_64"
JWT_REFRESH_SECRET="change_me_generate_with_openssl_rand_base64_64_different"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AES_KEY="change_me_64_char_hex_string_from_openssl_rand_hex_32_output_here"

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Next.js ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change_me_generate_with_openssl_rand_base64_32"

# ─── AXON System ──────────────────────────────────────────────────────────────
AXON_CONTROL_TOWER_URL="http://localhost:8200"
AXON_CONTROL_TOWER_API_KEY=""

# ─── Python AI Sidecar ────────────────────────────────────────────────────────
AI_SIDECAR_URL="http://localhost:8210"

# ─── SMTP (Notifications) ─────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@axon.local"

# ─── Slack / Discord / Telegram (Notifications) ───────────────────────────────
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""

# ─── Observability ────────────────────────────────────────────────────────────
LOGFIRE_TOKEN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# ─── Security ─────────────────────────────────────────────────────────────────
CSRF_HEADER="X-AXON-Request"
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
