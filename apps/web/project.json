{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": [
        "{workspaceRoot}/apps/web/.next/!(cache)/**/*",
        "{workspaceRoot}/apps/web/.next/!(cache)"
      ],
      "options": {
        "cwd": "apps/web",
        "tty": false,
        "command": "NODE_ENV=production next build --webpack"
      }
    }
  }
}
